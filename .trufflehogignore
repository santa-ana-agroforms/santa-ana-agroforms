# --- Ignorar rutas de tooling y outputs del repositorio ---
path:node_modules/**
path:dist/**
path:build/**
path:coverage/**
path:cypress/videos/**
path:cypress/screenshots/**
path:selenium_tests/**/artifacts/**
path:mocha_tests/node_modules/**
path:.scannerwork/**
path:.husky/**
path:.vscode/**

# --- Patrones públicos conocidos que no deben alertar ---
# Claves públicas, certificados de pruebas, etc.
pattern:-----BEGIN PUBLIC KEY-----
pattern:sample_public_key
pattern:example_fake_secret_

# --- Archivos de configuración frecuentemente ruidosos (si existen) ---
path:*.snap
path:*.map
